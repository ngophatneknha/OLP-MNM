# Sao chép thành .env và đổi mật khẩu. KHÔNG commit file .env.

POSTGRES_USER=dxlab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dxlab

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Địa chỉ trình duyệt dùng để tới Keycloak (đổi khi triển khai lên Internet)
KEYCLOAK_PUBLIC_URL=http://localhost:8081
# Địa chỉ trình duyệt dùng để tới API gateway
API_PUBLIC_URL=http://localhost:9080
# Origin của ứng dụng web được phép gọi API qua gateway (CORS)
APP_ORIGIN=http://localhost:3000

HASURA_ADMIN_SECRET=change-me

FLOWABLE_USER=flowable-admin
FLOWABLE_PASSWORD=change-me
# Bí mật dùng chung giữa Hasura event trigger và workflow-bridge
BRIDGE_SECRET=change-me

# Trợ lý AI sinh ứng dụng từ mô tả (TÙY CHỌN - để trống thì hệ thống vẫn chạy đủ, chỉ tắt tính năng AI).
# Dùng bất kỳ máy chủ tương thích OpenAI /chat/completions. Ví dụ chạy nội bộ bằng Ollama (nguồn mở):
#   AI_BASE_URL=http://host.docker.internal:11434/v1   AI_MODEL=mistral-small   AI_API_KEY=ollama
# Lưu ý: nếu trỏ tới dịch vụ ngoài, nội dung mô tả quy trình sẽ được gửi tới dịch vụ đó.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
