# Sao chép thành .env và đổi mật khẩu. KHÔNG commit file .env.

POSTGRES_USER=dxlab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dxlab

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Địa chỉ trình duyệt dùng để tới Keycloak (đổi khi triển khai lên Internet)
KEYCLOAK_PUBLIC_URL=http://localhost:8081
# Địa chỉ trình duyệt dùng để tới API gateway
API_PUBLIC_URL=http://localhost:9080
# Origin của ứng dụng web được phép gọi API qua gateway (CORS)
APP_ORIGIN=http://localhost:3000

HASURA_ADMIN_SECRET=change-me

FLOWABLE_USER=flowable-admin
FLOWABLE_PASSWORD=change-me
# Bí mật dùng chung giữa Hasura event trigger và workflow-bridge
BRIDGE_SECRET=change-me

# Trợ lý AI sinh ứng dụng từ mô tả (TÙY CHỌN - để trống thì hệ thống vẫn chạy đủ, chỉ tắt tính năng AI).
# Dùng bất kỳ máy chủ tương thích OpenAI /chat/completions. Ví dụ chạy nội bộ bằng Ollama (nguồn mở):
#   AI_BASE_URL=http://host.docker.internal:11434/v1   AI_MODEL=mistral-small   AI_API_KEY=ollama
# Lưu ý: nếu trỏ tới dịch vụ ngoài, nội dung mô tả quy trình sẽ được gửi tới dịch vụ đó.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Khóa truy cập kho đối tượng S3 (SeaweedFS bắt buộc ký SigV4). Đổi trước khi đưa lên Internet.
S3_ACCESS_KEY=dxlab-s3-access
S3_SECRET_KEY=change-me
# Khóa mã hóa khóa riêng của chữ ký số (PKI). Đổi khi triển khai thật; để trống thì dùng HASURA_ADMIN_SECRET.
PKI_MASTER_KEY=change-me

# Máy được nhận thông báo thuê bao NGSI-LD, dạng "máy:cổng,máy-khác" (trống là cấm gửi thông báo).
# ngsi-sink:4000 là máy nhận thử của bộ kiểm thử (IOT-09); triển khai thật thay bằng máy chủ của đối tác.
NGSI_NOTIFY_ALLOW=ngsi-sink:4000

# Trục sự kiện NATS (tùy chọn, profile stream): đặt NATS_URL=nats://nats:4222 để workflow-bridge phát sự kiện duyệt hồ sơ; trống là tắt.
NATS_URL=
NATS_TOKEN=change-me

# Tìm ngữ nghĩa không thêm container (máy ít RAM, cần profile search): mô hình HuggingFace, khuyên dùng sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (Apache-2.0, tải lần đầu; RAM Meili ~950 MB).
# Ghim phiên bản mô hình bằng "tên@mã-commit", ví dụ sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2@e8f8c211226b894fcb81acc59f3b34ba3efd5f42. Để trống là chỉ tìm từ khóa.
SEARCH_EMBEDDER=

# Tìm ngữ nghĩa, cách khuyên dùng (cần profile search và vector): Qdrant + dịch vụ nhúng riêng, không dùng Ollama, chỉ cần CPU, RAM ~0,7 GB.
# Bật bằng VECTOR_URL=http://qdrant:6333 và EMBED_URL=http://embedder (khi đó SEARCH_EMBEDDER bị bỏ qua). Xem docs/TRI_TUE.md.
# Mặc định chạy bản int8 của sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (tải sẵn, kiểm sha256, không cần tiền tố); đổi mô hình thì khởi động lại workflow-bridge (nó tự dựng lại kho véc-tơ và nhúng lại), và đặt hai tiền tố nếu mô hình mới yêu cầu.
VECTOR_URL=
EMBED_URL=
VECTOR_API_KEY=change-me-vector-key
EMBED_API_KEY=change-me-embed-key
# Máy chủ dư RAM/CPU muốn độ đúng cao hơn (39/39 thay vì 33/39, nhưng RAM 1,56 GB và nạp chậm gấp 10 lần):
# EMBED_MODEL=Alibaba-NLP/gte-multilingual-base
# EMBED_REVISION=9bbca17d9273fd0d03d5725c7a4b0f6b45142062
# EMBED_QUERY_PREFIX=
# EMBED_DOC_PREFIX=

# Khóa của Meilisearch (chỉ dùng khi bật profile search).
MEILI_MASTER_KEY=change-me-meili-key
