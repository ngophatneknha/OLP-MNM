# Sao chép thành .env và đổi mật khẩu. KHÔNG commit file .env.

POSTGRES_USER=dxlab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dxlab

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

HASURA_ADMIN_SECRET=change-me
# Khóa HS256 >= 32 ký tự (dùng tạm cho dev; sẽ chuyển sang JWKS của Keycloak ở Tuần 1-2)
HASURA_JWT_SECRET={"type":"HS256","key":"change-me-change-me-change-me-32chars"}

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-min8
