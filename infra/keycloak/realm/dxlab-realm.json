{
  "realm": "dxlab",
  "enabled": true,
  "bruteForceProtected": true,
  "failureFactor": 8,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "permanentLockout": false,
  "roles": {
    "realm": [
      {
        "name": "staff",
        "description": "Nhân viên"
      },
      {
        "name": "manager",
        "description": "Quản lý – phê duyệt yêu cầu"
      },
      {
        "name": "director",
        "description": "Giám đốc"
      },
      {
        "name": "accountant",
        "description": "Kế toán"
      },
      {
        "name": "admin",
        "description": "Quản trị hệ thống"
      }
    ]
  },
  "clients": [
    {
      "clientId": "dxlab-app",
      "name": "DX-Lab Project Hub",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dxlab-cli",
      "name": "Công cụ dòng lệnh (kiểm thử, nạp dữ liệu mẫu)",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
